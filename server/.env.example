# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
# Public address of this server (web app, admin, API, share links)
PUBLIC_API_URL=http://localhost:4000
# Only needed for front ends hosted on another origin
CORS_ORIGINS=
TRUST_PROXY=1

MONGODB_URI=mongodb://localhost:27017/mymusic

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OFFLINE_KEY_SECRET=
DATA_ENCRYPTION_KEY=

# OAuth client ids whose ID tokens are accepted (iOS, Android and web client ids)
GOOGLE_CLIENT_IDS=
# iOS bundle id(s), e.g. app.mymusic.ios
APPLE_BUNDLE_IDS=
# Web app sign-in buttons (optional)
GOOGLE_WEB_CLIENT_ID=
APPLE_WEB_SERVICES_ID=
# Optional: Sign in with Apple REST API (token revocation on account deletion)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY=

YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=US
YOUTUBE_CACHE_TTL_SECONDS=3600

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_FAMILY_MONTHLY=
# Only enable where the App Store / Play Store rules for the storefront allow external purchase links
ALLOW_IOS_EXTERNAL_PURCHASE=false
ALLOW_ANDROID_EXTERNAL_PURCHASE=false

S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
# Only if browsers reach storage on a different host than the server does (e.g. MinIO in docker)
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ASSET_PUBLIC_BASE_URL=
STREAM_URL_TTL_SECONDS=600

OFFLINE_LICENSE_DAYS=30
MAX_OFFLINE_DEVICES=3

SMTP_URL=
MAIL_FROM=MyMusic <no-reply@mymusic.app>

# Built front ends served by this process (relative to server/); empty disables
WEB_DIST_DIR=../web/dist
ADMIN_DIST_DIR=../admin/dist
